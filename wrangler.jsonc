{
  "name": "mysmartpass",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smartpass"
    }
  ],
  "vars": {
    "ACCESS_CODE": "Uncle!"
  }
}
